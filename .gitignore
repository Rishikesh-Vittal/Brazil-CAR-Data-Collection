# Publish CAR JSON/PDF data and folder placeholders; keep other run files local.
/outputs/**
!/outputs/**/
!/outputs/**/.gitkeep
!/outputs/acre/json/*.json
!/outputs/acre/pdf/acre/*.pdf

# Local runtime and assistant metadata.
/.car_scraper_runtime/
/.agents/
/.codex/

# Python caches and virtual environments.
__pycache__/
*.py[cod]
/.venv/
/venv/

# Local credentials.
.env
.env.*
!.env.example
